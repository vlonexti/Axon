// Number formatting matches C#: shortest digits that read back exactly.
int main() {
    double[] ds = [450.0, 0.1, 0.1 + 0.2, 1.0 / 3.0, 123456789.0, 1e20, 1.5e-7, -2.5, 0.0, 100.0, 1e15, 0.00001234];
    foreach (var d in ds) {
        print(d);
    }
    float f = 450.0f;
    print(f);
    print(0.1f);
    print(1.0f / 3.0f);
    print($"{960 / 2.0} {(960 - 60.0f) / 2}");
    return 0;
}
