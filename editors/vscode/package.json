{
  "name": "axon-lang",
  "displayName": "Axon",
  "description": "Axon language support: highlighting, errors as you type, hover, go to definition, completion and formatting (via `axon lsp`).",
  "version": "0.5.0",
  "publisher": "axon",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Formatters"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:axon"],
  "contributes": {
    "languages": [
      {
        "id": "axon",
        "aliases": ["Axon", "axon"],
        "extensions": [".ax"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "axon", "scopeName": "source.axon", "path": "./syntaxes/axon.tmLanguage.json" }
    ],
    "configuration": {
      "title": "Axon",
      "properties": {
        "axon.path": {
          "type": "string",
          "default": "axon",
          "description": "Path to the axon executable (it must be on PATH if left as `axon`)."
        }
      }
    }
  }
}
