// Uses the `vecmath` package from ../vecmath.
using vecmath;
using vecmath.geometry;

int main() {
    Vec a = new Vec { x = 3, y = 4 };
    Vec b = add(a, new Vec { x = 1, y = 1 });
    print(a.length());
    print(b);
    print(dot(a, b));
    Circle c = new Circle { r = 2 };
    print(c.area());
    return 0;
}
